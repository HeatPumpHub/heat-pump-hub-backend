generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  CLIENT
  INSTALLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  ARCHIVED
  BANNED
}

model User {

id String @id @default(uuid())
email String @unique
phoneNumber String @unique
firstName String
lastName String
avatar String? 
role Role 
roleSpecificCharacteristics Json
status UserStatus @default(ACTIVE)
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

}