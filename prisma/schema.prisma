generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Role {
  CLIENT
  INSTALLER
  ADMIN
}

enum UserStatus {
  ACTIVE
  ARCHIVED
  BANNED
}

enum ItemCategory {
  OUTDOOR_UNIT
  INDOOR_UNIT
  HYDROBOX
  CONTROLLER
  HOT_WATER_CYLINDER
  BUFFER_VESSEL
  CIRCULATION_PUMP
  ACCESSORY
}

enum OfferStatus {
  ACTIVE
  EXPIRED
  ARCHIVED
}

model User {

id String @id @default(uuid())
email String @unique
phoneNumber String @unique
firstName String
lastName String
avatar String? 
role Role 
roleSpecificCharacteristics Json
status UserStatus @default(ACTIVE)
buildingAssessments BuildingAssessment[]
offers Offer[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

@@map("users")

}
model Item {

id String @id @default(uuid())
name String @unique
brand String
price Decimal @db.Decimal(10, 2)
image String
description String
warranty Int
manufacturerNumber String @unique
category ItemCategory
categorySpecificCharacteristics Json
isArchived Boolean @default(false)
combinationItems CombinationItem[]
createdAt DateTime @default(now())
updatedAt DateTime @updatedAt

@@map("items")

}

model BuildingAssessment {

  id String @id @default(uuid())
  name String
  userId String
  user User @relation(fields: [userId], references: [id])
  manualInputData Json
  manualCalculatedPower Float
  manualCalculatedDHWVolume Int
  isArchived Boolean @default(false)
  offers Offer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("building_assessments")

}

model Combination {

  id String @id @default(uuid())
  name String
  isArchived Boolean @default(false)
  combinationItems CombinationItem[]
  offers Offer[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("combinations")

}

model CombinationItem {

  id String @id @default(uuid())
  combinationId String
  combination Combination @relation(fields: [combinationId], references: [id])
  itemId String
  item Item @relation(fields: [itemId], references: [id])
  quantity Int @default(1) 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([combinationId, itemId])
  @@map("combination_items")

}

model Offer {

  id String @id @default(uuid())
  userId String
  buildingAssessmentId String
  combinationId String
  offerSnapshot Json
  price Decimal @db.Decimal(10, 2)
  discount Int @default(0) @db.SmallInt
  status OfferStatus @default(ACTIVE)
  expirationDate DateTime
  user User @relation(fields: [userId], references: [id])
  buildingAssessment BuildingAssessment @relation(fields: [buildingAssessmentId], references: [id])
  combination Combination @relation(fields: [combinationId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("offers")

}